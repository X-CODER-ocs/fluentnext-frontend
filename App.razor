@using Microsoft.FluentUI.AspNetCore.Components
@using FluentNext.Frontend.Services
@inject ClientSettings ClientSettings
@inject IOptions<FluentNextConfig> Config
@inject IJSRuntime JS

@* Fluent UI 官方设计主题：强调色用用户自定义色（默认品牌绿），明暗跟随客户端设置 *@
<FluentDesignTheme Mode="@_mode" CustomColor="@_brandColor" StorageName="fluentnext-theme" />

<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="fn-fatal">
            <div class="fn-fatal-logo">Fluent<span>Next</span></div>
            <p class="fn-fatal-title">页面渲染时遇到未处理的异常</p>
            <p class="fn-fatal-hint">异常信息已记录到浏览器控制台（F12 → Console）。</p>
            <a href="." class="fn-fatal-reload">重新加载页面</a>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private DesignThemeModes _mode = DesignThemeModes.System;
    private string _brandColor = "#4AA26F";

    protected override async Task OnInitializedAsync()
    {
        await ClientSettings.InitAsync();
        _brandColor = string.IsNullOrWhiteSpace(ClientSettings.Data.Accent)
            ? Config.Value.BrandColor
            : ClientSettings.Data.Accent;
        _mode = ThemeToMode(ClientSettings.Data.Theme);
        ClientSettings.Changed += OnSettingsChanged;
        ApplyUserTheme();
    }

    private void OnSettingsChanged()
    {
        _mode = ThemeToMode(ClientSettings.Data.Theme);
        _brandColor = string.IsNullOrWhiteSpace(ClientSettings.Data.Accent)
            ? Config.Value.BrandColor
            : ClientSettings.Data.Accent;
        ApplyUserTheme();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>把用户自定义的主题（强调色 / 背景 / 文字 / 字体）写入 CSS 变量，覆盖 Fluent 默认令牌</summary>
    private void ApplyUserTheme()
    {
        var d = ClientSettings.Data;
        _ = JS.InvokeVoidAsync("fluentNextApplyUserTheme", new
        {
            accent = d.Accent,
            background = d.Background,
            foreground = d.Foreground,
            fontFamily = FontToStack(d.FontFamily)
        });
    }

    private static string FontToStack(string key) => key switch
    {
        "sans" => "Arial, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif",
        "serif" => "Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif",
        "mono" => "'Cascadia Code', Consolas, 'Courier New', monospace",
        _ => "'Segoe UI', system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif"
    };

    private static DesignThemeModes ThemeToMode(string theme) => theme switch
    {
        "Light" => DesignThemeModes.Light,
        "Dark" => DesignThemeModes.Dark,
        _ => DesignThemeModes.System
    };
}
