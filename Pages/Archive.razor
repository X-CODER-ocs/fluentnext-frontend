@page "/archive"
@using FluentNext.Frontend.Services
@using FluentNext.Frontend.Components
@inject ContentService Content

<PageTitle>归档</PageTitle>

<div class="fn-home">
    <header class="fn-sec-head">
        <a href="./" class="fn-back">← 首页</a>
        <h1>归档</h1>
        <span class="fn-muted">共 @(_total) 篇</span>
    </header>

    @if (_loading)
    {
        <p class="fn-muted">加载中…</p>
    }
    else if (_groups.Count == 0)
    {
        <p class="fn-muted">暂无文章。</p>
    }
    else
    {
        @foreach (var g in _groups)
        {
            <h2 class="fn-arch-year">@g.Year <span class="fn-muted">（@g.Posts.Count 篇）</span></h2>
            <PostList Posts="g.Posts" />
        }
    }
</div>

@code {
    private bool _loading = true;
    private int _total;
    private List<ArchiveGroup> _groups = new();

    private class ArchiveGroup
    {
        public int Year { get; set; }
        public List<BlogPost> Posts { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        var data = await Content.GetContentAsync();
        _groups = data.Posts
            .GroupBy(p => p.Date.Year)
            .OrderByDescending(g => g.Key)
            .Select(g => new ArchiveGroup
            {
                Year = g.Key,
                Posts = g.OrderByDescending(p => p.Date).ToList()
            })
            .ToList();
        _total = data.Posts.Count;
        _loading = false;
    }
}
