@page "/category/{slug}"
@using FluentNext.Frontend.Services
@using FluentNext.Frontend.Components
@inject ContentService Content

<PageTitle>分类：@(_name)</PageTitle>

<div class="fn-home">
    <header class="fn-sec-head">
        <a href="./" class="fn-back">← 首页</a>
        <h1>分类：@_name</h1>
        <span class="fn-muted">共 @_posts.Count 篇</span>
    </header>
    @if (_loading)
    {
        <p class="fn-muted">加载中…</p>
    }
    else
    {
        <PostList Posts="_posts" />
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private List<BlogPost> _posts = new();
    private string _name = "";
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        var data = await Content.GetContentAsync();
        _name = Uri.UnescapeDataString(Slug);
        _posts = data.Posts
            .Where(p => p.Categories.Contains(_name))
            .OrderByDescending(p => p.Date)
            .ToList();
        _loading = false;
    }
}
