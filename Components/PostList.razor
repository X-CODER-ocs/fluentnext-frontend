@namespace FluentNext.Frontend.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using FluentNext.Frontend
@using FluentNext.Frontend.Services
@inject ClientSettings ClientSettings

@if (Posts is null || Posts.Count == 0)
{
    <p class="fn-muted">暂无内容。</p>
}
else if (ClientSettings.Data.Layout == "list")
{
    @* 列表：仅标题 + 日期 *@
    <ul class="fn-list">
        @foreach (var p in Posts)
        {
            <li class="fn-list-item">
                <a href="@($"post/{p.Slug}")" class="fn-list-title">@p.Title</a>
                <span class="fn-list-date">@p.Date.ToString("yyyy-MM-dd")</span>
            </li>
        }
    </ul>
}
else
{
    @* 杂志：含内容 *@
    <div class="fn-magazine">
        @foreach (var p in Posts)
        {
            <FluentCard Class="fn-post-card">
                <div class="fn-post-meta">
                    <span>@p.Date.ToString("yyyy-MM-dd")</span>
                    @foreach (var c in p.Categories)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Class="fn-cat">@c</FluentBadge>
                    }
                </div>
                <a href="@($"post/{p.Slug}")" class="fn-post-title">@p.Title</a>
                <div class="fn-post-content fn-markdown">
                    @((MarkupString)(string.IsNullOrEmpty(p.Content) ? p.Excerpt : p.Content))
                </div>
                <a href="@($"post/{p.Slug}")" class="fn-readmore">阅读全文 →</a>
            </FluentCard>
        }
    </div>
}

@code {
    [Parameter]
    public List<BlogPost> Posts { get; set; } = new();
}
