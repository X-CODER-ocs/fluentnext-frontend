@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@using FluentNext.Frontend.Services
@inject ClientSettings ClientSettings
@inject IOptions<FluentNextConfig> Config
@inject ContentService Content
@inject AppState AppState
@implements IDisposable

@* 组件 Provider（Toast / Tooltip / MessageBar / Menu）*@
<FluentToastProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

<div class="fn-app">
    <NavMenu />
    <main class="fn-main">
        <header class="fn-topbar">
            <span class="fn-brand">@(_siteTitle)</span>
        </header>
        <div class="fn-body" style="font-size:@(ClientSettings.Data.FontSize)px">
            @Body
        </div>
    </main>
</div>

@if (_showSettings)
{
    <div class="fn-backdrop" @onclick="ToggleSettings"></div>
    <aside class="fn-drawer">
        <div class="fn-drawer-head">
            <strong>外观设置</strong>
            <FluentButton Appearance="Appearance.Lightweight" OnClick="ToggleSettings">关闭</FluentButton>
        </div>

        <div class="fn-field">
            <label>布局</label>
            <FluentSelect TOption="string" Value="@ClientSettings.Data.Layout" ValueChanged="OnLayoutChanged">
                <FluentOption TOption="string" Value="list">列表（仅标题）</FluentOption>
                <FluentOption TOption="string" Value="magazine">杂志（含内容）</FluentOption>
            </FluentSelect>
        </div>

        <div class="fn-field">
            <label>主题</label>
            <FluentSelect TOption="string" Value="@ClientSettings.Data.Theme" ValueChanged="OnThemeChanged">
                <FluentOption TOption="string" Value="Light">浅色</FluentOption>
                <FluentOption TOption="string" Value="Dark">深色</FluentOption>
                <FluentOption TOption="string" Value="System">跟随系统</FluentOption>
            </FluentSelect>
        </div>

        <div class="fn-field">
            <label>正文字号：@(ClientSettings.Data.FontSize)px</label>
            <FluentSlider @bind-Value="FontSize" Min="14" Max="22" Step="1" />
        </div>

        <div class="fn-field">
            <label>强调色（主色）</label>
            <input type="color" class="fn-color" @bind="Accent" />
        </div>

        <div class="fn-field">
            <label>背景色</label>
            <input type="color" class="fn-color" @bind="BgValue" />
            <button type="button" class="fn-reset" @onclick="ResetBg">恢复为跟随主题</button>
        </div>

        <div class="fn-field">
            <label>文字色</label>
            <input type="color" class="fn-color" @bind="FgValue" />
            <button type="button" class="fn-reset" @onclick="ResetFg">恢复为跟随主题</button>
        </div>

        <div class="fn-field">
            <label>字体</label>
            <FluentSelect TOption="string" Value="@ClientSettings.Data.FontFamily" ValueChanged="OnFontChanged">
                <FluentOption TOption="string" Value="system">系统默认</FluentOption>
                <FluentOption TOption="string" Value="sans">无衬线（黑体）</FluentOption>
                <FluentOption TOption="string" Value="serif">衬线（宋体）</FluentOption>
                <FluentOption TOption="string" Value="mono">等宽（代码）</FluentOption>
            </FluentSelect>
        </div>

        <p class="fn-hint">设置保存在本浏览器，不同设备 / 不同观看者互不影响。</p>
    </aside>
}

@code {
    private bool _showSettings;
    private string _siteTitle = "X-CODER";

    protected override async Task OnInitializedAsync()
    {
        var data = await Content.GetContentAsync();
        if (!string.IsNullOrEmpty(data.Site.Title)) _siteTitle = data.Site.Title;
        AppState.SettingsOpenRequested += OnSettingsRequested;
    }

    private void OnSettingsRequested()
    {
        _showSettings = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleSettings() => _showSettings = !_showSettings;

    private async Task OnLayoutChanged(string value)
    {
        ClientSettings.SetLayout(value);
        await ClientSettings.SaveAsync();
    }

    private async Task OnThemeChanged(string value)
    {
        ClientSettings.SetTheme(value);
        await ClientSettings.SaveAsync();
    }

    private async Task OnFontChanged(string value)
    {
        ClientSettings.SetFontFamily(value);
        await ClientSettings.SaveAsync();
    }

    private int FontSize
    {
        get => ClientSettings.Data.FontSize;
        set { ClientSettings.SetFontSize(value); _ = ClientSettings.SaveAsync(); }
    }

    // 强调色：直接双向绑定到设置
    private string Accent
    {
        get => ClientSettings.Data.Accent;
        set { ClientSettings.SetAccent(value); _ = ClientSettings.SaveAsync(); }
    }

    // 背景 / 文字色：为空表示「跟随主题」，此时颜色选择器显示主题默认值但不写入覆盖。
    private string BgValue
    {
        get => string.IsNullOrEmpty(ClientSettings.Data.Background) ? ThemeDefaultBg : ClientSettings.Data.Background;
        set { ClientSettings.SetBackground(value); _ = ClientSettings.SaveAsync(); }
    }

    private string FgValue
    {
        get => string.IsNullOrEmpty(ClientSettings.Data.Foreground) ? ThemeDefaultFg : ClientSettings.Data.Foreground;
        set { ClientSettings.SetForeground(value); _ = ClientSettings.SaveAsync(); }
    }

    private async Task ResetBg()
    {
        ClientSettings.SetBackground("");
        await ClientSettings.SaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetFg()
    {
        ClientSettings.SetForeground("");
        await ClientSettings.SaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private string ThemeDefaultBg => ClientSettings.Data.Theme == "Dark" ? "#1f1f1f" : "#fafafa";
    private string ThemeDefaultFg => ClientSettings.Data.Theme == "Dark" ? "#f3f3f3" : "#242424";

    public void Dispose() => AppState.SettingsOpenRequested -= OnSettingsRequested;
}
